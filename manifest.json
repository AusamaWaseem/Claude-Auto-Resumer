{
  "manifest_version": 3,
  "name": "Claude Auto-Resume",
  "version": "1.0.0",
  "description": "Automatically resumes Claude.ai after usage-limit cooldown — works even when your PC is off.",
  "permissions": [
    "alarms",
    "tabs",
    "storage",
    "scripting",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["fetch-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Auto-Resume"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
